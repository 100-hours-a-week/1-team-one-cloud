{
  "uid": "pure-ai",
  "title": "Production: AI Server (FastAPI)",
  "refresh": "10s",
  "schemaVersion": 36,
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "query",
        "datasource": {
          "uid": "Prometheus",
          "type": "prometheus"
        },
        "query": "label_values(up{application=\"ai-server\"}, environment)",
        "refresh": 1
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "uid": "Prometheus",
          "type": "prometheus"
        },
        "query": "label_values(up{application=\"ai-server\", environment=\"$environment\"}, instance)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "FastAPI Requests Per Sec (RPS)",
      "type": "timeseries",
      "datasource": {
        "uid": "Prometheus",
        "type": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{application=\"ai-server\", environment=\"$environment\", instance=~\"$instance\"}[1m])) by (handler)",
          "refId": "A",
          "legendFormat": "{{handler}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 2,
      "title": "FastAPI Error Rates (4xx / 5xx)",
      "type": "timeseries",
      "datasource": {
        "uid": "Prometheus",
        "type": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"4..|5..\", application=\"ai-server\", environment=\"$environment\", instance=~\"$instance\"}[1m])) by (handler, status)",
          "refId": "A",
          "legendFormat": "{{handler}} - {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 3,
      "title": "FastAPI Avg Latency",
      "type": "timeseries",
      "datasource": {
        "uid": "Prometheus",
        "type": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_seconds_sum{application=\"ai-server\", environment=\"$environment\", instance=~\"$instance\"}[1m])) / sum(rate(http_request_duration_seconds_count{application=\"ai-server\", environment=\"$environment\", instance=~\"$instance\"}[1m]))",
          "refId": "A",
          "legendFormat": "Avg Latency - {{handler}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Process CPU Usage",
      "type": "timeseries",
      "datasource": {
        "uid": "Prometheus",
        "type": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{application=\"ai-server\", environment=\"$environment\", instance=~\"$instance\"}[1m])",
          "refId": "A",
          "legendFormat": "CPU Usage - {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Process Resident Memory",
      "type": "timeseries",
      "datasource": {
        "uid": "Prometheus",
        "type": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{application=\"ai-server\", environment=\"$environment\", instance=~\"$instance\"}",
          "refId": "A",
          "legendFormat": "RAM Used - {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Open File Descriptors (FDs)",
      "type": "timeseries",
      "datasource": {
        "uid": "Prometheus",
        "type": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "process_open_fds{application=\"ai-server\", environment=\"$environment\", instance=~\"$instance\"}",
          "refId": "A",
          "legendFormat": "Open FDs"
        },
        {
          "expr": "process_max_fds{application=\"ai-server\", environment=\"$environment\", instance=~\"$instance\"}",
          "refId": "B",
          "legendFormat": "Max FDs Lock"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "lineWidth": 2
          }
        }
      }
    }
  ]
}